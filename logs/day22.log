数据真实且有教学价值。补充一个关键对比（per-token 激活量化的层输出误差——验证「outlier 在每个 token 行里，per-token 救不了」）：
[0m$ [0mcd /tmp/opencode && python3 -c "
import torch
torch.manual_seed(42)
M, N, K = 600, 256, 512
W = torch.randn(N, K) * 0.02
X = torch.randn(M, K)
outlier_ch = [3, 17, 100, 233]
X[:, outlier_ch] *= 60

def quant_sym(x, bits, scales):
    qmax = 2 ** (bits - 1) - 1
    return torch.clamp(torch.round(x / scales), -qmax, qmax) * scales

def scales_for(x, bits, granularity):
    qmax = 2 ** (bits - 1) - 1
    if granularity == 'tensor': return x.abs().max() / qmax
    if granularity == 'row': return x.abs().amax(dim=-1, keepdim=True) / qmax

Wq = quant_sym(W, 8, scales_for(W, 8, 'row'))
Y = X @ W.T
Xq_pt = quant_sym(X, 8, scales_for(X, 8, 'row'))
rel_pt = ((Y - Xq_pt @ Wq.T)**2).sum().sqrt() / (Y**2).sum().sqrt()
print(f'per-token INT8 X + per-channel INT8 W: 层输出相对误差 = {rel_pt:.2%}')

alpha = 0.5
s = X.abs().amax(dim=0)**alpha / W.abs().amax(dim=0)**(1-alpha)
Xs, Ws = X / s, W * s
