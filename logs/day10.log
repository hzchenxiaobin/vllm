"""day10_sim.py - V1 Scheduler skeleton sim: two queues + budget accounting (no KV)"""
import heapq, sys
from dataclasses import dataclass

K = int(sys.argv[1]) if len(sys.argv) > 1 else 8192
S = 1024

@dataclass
class Req:
    rid: int; prompt: int; out: int = 0
    priority: int = 0; arrival: float = 0.0
    computed: int = 0
    ttft: float = -1.0

waiting, running = [], []
t, step_n = 0.0, 0

def arrivals():
    return [(1, 0.00, 2000, 0), (2, 0.05, 2000, 0), (3, 0.10, 2000, 0),
            (4, 0.15, 2000, 0), (5, 0.20, 6000, 0)]

future = arrivals()
while future or waiting or running:
    while future and future[0][1] <= t:
        rid, arr, p, pr = future.pop(0)
        heapq.heappush(waiting, (pr, arr, Req(rid, p, 0, pr, arr)))
    budget = K
    batch = []
    for r in list(running):
        if r.computed < r.prompt:
            n = min(r.prompt - r.computed, budget)
            r.computed += n; budget -= n
            batch.append((r.rid, n, "P"))
            if r.computed == r.prompt:
                r.ttft = t; r.out = 1
        elif r.out < 9:
            budget -= 1; r.out += 1
            batch.append((r.rid, 1, "D"))
    while waiting and budget > 0 and len(running) < S:
        _, _, r = waiting[0]
        n = min(r.prompt - r.computed, budget)
        heapq.heappop(waiting)
        running.append(r)
        r.computed += n; budget -= n
        batch.append((r.rid, n, "N"))
        if r.computed == r.prompt:
            r.ttft = t; r.out = 1
    assert sum(b[1] for b in batch) <= K
    step_n += 1
    sched = sum(b[1] for b in batch)
    print(f"step {step_n:>2}  t={t:6.1f}ms  batch={batch}  Σ={sched}  "
          f"running={len(running)} waiting={len(waiting)}")
    t += 5 + 0.033 * sched
    done = [r for r in running if r.out >= 9]
    for r in done:
        running.remove(r)
        print(f"    req {r.rid} finished, TTFT={r.ttft:.1f}ms")
